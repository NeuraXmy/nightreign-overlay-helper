<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.6" GeneratePathProperty="true" />
    <PackageReference Include="Steamworks.NET" Version="20.2.0" />
  </ItemGroup>

  <Target Name="CopyTraceEventKernelSupport" AfterTargets="Publish">
    <ItemGroup>
      <TraceEventKernelSupport Include="$(PkgMicrosoft_Diagnostics_Tracing_TraceEvent)\build\native\amd64\KernelTraceControl.dll" />
      <TraceEventKernelSupport Include="$(PkgMicrosoft_Diagnostics_Tracing_TraceEvent)\build\native\amd64\msdia140.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(TraceEventKernelSupport)" DestinationFolder="$(PublishDir)amd64" />
  </Target>
</Project>
